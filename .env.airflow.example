# Generated secrets and machine-specific cache path are created by scripts/airflow.ps1 setup.
AIRFLOW_UID=50000
AIRFLOW_UI_PORT=8080
AIRFLOW_POSTGRES_PASSWORD=GENERATE_WITH_SETUP
AIRFLOW_JWT_SECRET=GENERATE_WITH_SETUP
AIRFLOW_API_SECRET=GENERATE_WITH_SETUP
AIRFLOW_ADMIN_PASSWORD=GENERATE_WITH_SETUP
AIRFLOW_NETWORK=tiki-absa-airflow-network
QDRANT_CONTAINER=tiki-qdrant
QDRANT_URL=http://qdrant:6333
QDRANT_COLLECTION=tiki_kb_test
HF_HUB_CACHE_HOST=C:/Users/User/.cache/huggingface/hub
HF_HUB_OFFLINE=1
KB_ABSA_MODEL=logreg
KB_PIPELINE_REVISION=1
KB_INDEX_BATCH_SIZE=2
KB_MAX_LENGTH=1024
KB_SCHEDULE=*/15 * * * *
KB_MAX_BATCHES=4
